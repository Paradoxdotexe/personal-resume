{{#data}}
<div class="experience">
    {{#logo}}<img class="experience__logo" src="{{ . }}" alt="">{{/logo}}
    {{^logo}}<div class="experience__logo experience__logo--placeholder"><img src="./icons/briefcase-solid-full.svg" alt=""></div>{{/logo}}
    <div class="experience__header">
        <div>
            <div class="experience__title">{{ title }}</div>
            <div class="experience__subtitle">{{ subtitle }}</div>
        </div>
        {{^roles.length}}<div class="experience__tag">{{ tag }}</div>{{/roles.length}}
    </div>
    {{#roles.length}}
    <div class="experience__roles">
        {{#roles}}
        <div class="experience__role">
            <div class="experience__role-rail"><span></span><span></span></div>
            <div class="experience__role-body">
                <div class="experience__role-header">
                    <div class="experience__role-title">{{ title }}</div>
                    <div class="experience__role-tag">{{ tag }}</div>
                </div>
                <div class="experience__content">{{{ content }}}</div>
            </div>
        </div>
        {{/roles}}
    </div>
    {{/roles.length}}
    {{^roles.length}}
    <div class="experience__content">{{{ content }}}</div>
    {{/roles.length}}
</div>
{{/data}}

<style>
    /*
     * Layout avoids position/z-index: positioned elements paint in a later pass,
     * which reorders the PDF text layer and scrambles it for resume parsers.
     */
    /* Logo in the left column; header, content, and roles in the right */
    .experience {
        --logo-size: 0.45in;
        --logo-gap: 0.12in;
        display: grid;
        grid-template-columns: var(--logo-size) 1fr;
        column-gap: var(--logo-gap);
    }

    .experience > :not(.experience__logo) {
        grid-column: 2;
    }

    .experience .experience__logo {
        grid-column: 1;
        grid-row: 1;
        width: var(--logo-size);
        height: var(--logo-size);
        border-radius: 4px;
        object-fit: cover;
    }

    .experience .experience__logo--placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.08);
    }

    .experience .experience__logo--placeholder img {
        width: 55%;
        opacity: 0.35;
    }

    .experience .experience__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.1in;
        margin-bottom: 0.1in;
    }

    .experience .experience__header .experience__title {
        font-size: var(--font-size-lg);
        font-weight: 600;
        margin-bottom: 0.025in;
    }

    .experience .experience__header .experience__subtitle {
        font-size: var(--font-size-sm);
        font-style: italic;
    }

    .experience .experience__header .experience__tag {
        margin-top: 0.03in;
        white-space: nowrap;
        font-size: var(--font-size-xs);
        color: rgba(0, 0, 0, 0.6);
    }

    .experience .experience__content {
        font-size: var(--font-size-sm);
    }

    /* Roles nested under a single company, connected by a timeline rail under the logo */
    .experience .experience__roles {
        --role-gap: 0.1in;
        --role-dot-size: 8px;
        display: flex;
        flex-direction: column;
    }

    .experience .experience__role {
        display: flex;
    }

    .experience .experience__role:not(:last-child) .experience__role-body {
        padding-bottom: var(--role-gap);
    }

    .experience .experience__role-rail {
        flex-shrink: 0;
        width: var(--logo-size);
        margin-left: calc(-1 * (var(--logo-size) + var(--logo-gap)));
        margin-right: var(--logo-gap);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .experience .experience__role-rail span:first-child {
        flex-shrink: 0;
        margin-top: 5px;
        width: var(--role-dot-size);
        height: var(--role-dot-size);
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.3);
    }

    .experience .experience__role-rail span:last-child {
        flex: 1;
        width: 2px;
        margin-top: 3px;
        background: rgba(0, 0, 0, 0.15);
    }

    .experience .experience__role:last-child .experience__role-rail span:last-child {
        display: none;
    }

    .experience .experience__role-body {
        flex: 1;
    }

    .experience .experience__role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.03in;
    }

    .experience .experience__role-title {
        font-size: var(--font-size-md);
        font-weight: 600;
    }

    .experience .experience__role-tag {
        font-size: var(--font-size-xs);
        color: rgba(0, 0, 0, 0.6);
        white-space: nowrap;
    }
</style>
