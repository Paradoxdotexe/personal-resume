{{#data}}
<div class="experience">
    {{#logo}}<img class="experience__logo" src="{{ . }}" alt="">{{/logo}}
    {{^logo}}<div class="experience__logo experience__logo--placeholder"><img src="./icons/briefcase-solid-full.svg" alt=""></div>{{/logo}}
    <div class="experience__header">
        <div class="experience__title">{{ title }}</div>
        <div class="experience__subtitle">{{ subtitle }}</div>
        <div class="experience__tag">{{ tag }}</div>
    </div>
    {{#roles.length}}
    <div class="experience__roles">
        {{#roles}}
        <div class="experience__role">
            <div class="experience__role-header">
                <div class="experience__role-title"><span></span>{{ title }}</div>
                <div class="experience__role-tag">{{ tag }}</div>
            </div>
            <div class="experience__content">{{{ content }}}</div>
        </div>
        {{/roles}}
    </div>
    {{/roles.length}}
    {{^roles.length}}
    <div class="experience__content">{{{ content }}}</div>
    {{/roles.length}}
</div>
{{/data}}

<style>
    /* Logo in the left column; header, content, and roles in the right */
    .experience {
        --logo-size: 0.45in;
        --logo-gap: 0.12in;
        display: grid;
        grid-template-columns: var(--logo-size) 1fr;
        column-gap: var(--logo-gap);
    }

    .experience > :not(.experience__logo) {
        grid-column: 2;
    }

    .experience .experience__logo {
        grid-column: 1;
        grid-row: 1;
        width: var(--logo-size);
        height: var(--logo-size);
        border-radius: 4px;
        object-fit: cover;
    }

    .experience .experience__logo--placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.08);
    }

    .experience .experience__logo--placeholder img {
        width: 55%;
        opacity: 0.35;
    }

    .experience .experience__header {
        position: relative;
        margin-bottom: 0.1in;
    }

    .experience .experience__header .experience__title {
        font-size: var(--font-size-lg);
        font-weight: 600;
        margin-bottom: 0.025in;
    }

    .experience .experience__header .experience__subtitle {
        font-size: var(--font-size-sm);
        font-style: italic;
    }

    .experience .experience__header .experience__tag {
        position: absolute;
        top: 0;
        right: 0;
        background: var(--accent-primary);
        color: var(--color-inverse-primary);
        font-size: var(--font-size-xs);
        line-height: 100%;
        padding: 0.03in 0.1in;
        border-radius: 16px;
    }

    .experience .experience__content {
        font-size: var(--font-size-sm);
    }

    /* Roles nested under a single company, connected by a small timeline */
    .experience .experience__roles {
        --role-gap: 0.1in;
        --role-dot-left: calc(-1 * (var(--logo-gap) + var(--logo-size) / 2));
        --role-dot-size: 8px;
        --role-dot-top: 5px;
        display: flex;
        flex-direction: column;
        gap: var(--role-gap);
    }

    .experience .experience__role {
        position: relative;
    }

    .experience .experience__role:not(:last-child)::after {
        content: '';
        position: absolute;
        left: calc(var(--role-dot-left) - 1px);
        top: calc(var(--role-dot-top) + var(--role-dot-size) + 3px);
        bottom: calc(-1 * var(--role-gap) + var(--role-dot-top) - 3px);
        width: 2px;
        background: rgba(0, 0, 0, 0.15);
    }

    .experience .experience__role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.03in;
    }

    .experience .experience__role-title {
        font-size: var(--font-size-md);
        font-weight: 600;
    }

    .experience .experience__role-title span {
        position: absolute;
        left: calc(var(--role-dot-left) - var(--role-dot-size) / 2);
        top: var(--role-dot-top);
        width: var(--role-dot-size);
        height: var(--role-dot-size);
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.3);
    }

    .experience .experience__role-tag {
        font-size: var(--font-size-xs);
        font-style: italic;
        color: rgba(0, 0, 0, 0.6);
        white-space: nowrap;
    }
</style>
