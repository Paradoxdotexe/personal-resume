{{#data}}
    <div class="sidebar__info">
        <strong>{{ title }}</strong>
        <div>{{{ subtitle }}}</div>
        <a href="{{ href }}">{{ link }}</a>
        <i>{{ subtitleItalic }}</i>
    </div>
{{/data}}

<style>
    .sidebar__info {
        display: flex;
        flex-direction: column;
    }

    /* Items only fill some fields; drop the empty ones so they take no space */
    .sidebar__info :empty {
        display: none;
    }

    .sidebar__info strong {
        margin-bottom: 0.05in;
        font-weight: 500;
    }

    .sidebar__info :not(strong) {
        font-size: var(--font-size-sm);
    }

    .sidebar__info a {
        color: var(--color-inverse-primary);
    }

    .sidebar__info i {
        font-size: var(--font-size-sm);
        margin-top: -0.05in;
    }

    /* Only tuck the italic line under the title when no subtitle sits between them */
    .sidebar__info div:not(:empty) ~ i:not(:empty) {
        margin-top: 0.03in;
    }
</style>
